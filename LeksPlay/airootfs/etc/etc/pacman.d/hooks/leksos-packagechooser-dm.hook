# remove from airootfs!
# Installs the LeksOS display-manager picker page config
# (packagechooser-displaymanager.conf) alongside alci-calamares-config, same
# pattern as the other leksos-*.hook overrides.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = alci-calamares-config

[Action]
Description = Installing LeksOS display-manager picker config...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/cp -f /usr/local/share/leksos/packagechooser-displaymanager.conf /etc/calamares/modules/packagechooser-displaymanager.conf
