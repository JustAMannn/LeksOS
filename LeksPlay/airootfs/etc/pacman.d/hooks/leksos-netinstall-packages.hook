# remove from airootfs!
# Installs the LeksOS combined "Packages" review page config
# (netinstall-packages.conf, replaces the separate netinstall-de/-dm/-bootloader
# confs which showed up as confusing near-duplicate step names next to the
# packagechooser pretty-picker pages) alongside alci-calamares-config, same
# pattern as the other leksos-*.hook overrides.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = alci-calamares-config

[Action]
Description = Installing LeksOS combined packages review config...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/cp -f /usr/local/share/leksos/netinstall-packages.conf /etc/calamares/modules/netinstall-packages.conf
