# remove from airootfs!
# Installs the LeksOS desktop-environment picker page config
# (packagechooser-de.conf, the pretty list+screenshot+description front page
# for netinstall-de.conf) alongside alci-calamares-config, same pattern as
# the other leksos-*.hook overrides.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = alci-calamares-config

[Action]
Description = Installing LeksOS desktop-environment picker config...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/cp -f /usr/local/share/leksos/packagechooser-de.conf /etc/calamares/modules/packagechooser-de.conf
