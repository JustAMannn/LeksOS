# remove from airootfs!
# alci-calamares-config ships etc/calamares/modules/removeuser.conf hardcoded
# to remove "liveuser" (upstream's default live account name). LeksOS's live
# account is "leksplay", so that default never matches and the live user was
# being left on every installed system. Overwrite post-install, same as
# leksos-packages-conf.hook does for packages.conf.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = alci-calamares-config

[Action]
Description = Pointing calamares removeuser.conf at LeksOS's live account...
When = PostTransaction
Depends = coreutils
Exec = /usr/bin/cp -f /usr/local/share/leksos/removeuser.conf /etc/calamares/modules/removeuser.conf
